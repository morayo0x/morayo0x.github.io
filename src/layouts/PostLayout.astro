---
// src/layouts/PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import Field from '@components/field/Field.astro';
import {
  getAllWriting,
  getThreads,
  nearest,
  describePosition,
  stamp,
  postUrl,
  type Letter,
} from '@utils/field';

interface Props {
  post: Letter;
}

const { post } = Astro.props;
const { title, description, pubDate, math, x, y, ogImage } = post.data;

const all = await getAllWriting();
const threads = await getThreads();

const entry = threads.find(({ thread }) => thread.id === post.data.thread);
const index = entry ? entry.posts.findIndex((p) => p.id === post.id) : -1;
const previous = entry && index > 0 ? entry.posts[index - 1] : undefined;
const next =
  entry && index >= 0 && index < entry.posts.length - 1 ? entry.posts[index + 1] : undefined;
const accent = entry?.thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)';

const nearby = nearest(post, all, 2);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  math={math}
  pubDate={pubDate}
  image={ogImage}
>
  <div class="container post-page">
    <div class="post-layout">
      <article class="post-main">
        <div class="post-meta">
          <span class="stamp">{stamp(pubDate)}</span>
          {
            entry && (
              <a
                href={`/threads/${entry.thread.id}/`}
                class="thread-badge"
                style={`color: ${accent}`}
              >
                <span class="thread-badge-dot" style={`background: ${accent}`} />
                {entry.thread.data.title} · {index + 1} of {entry.posts.length}
              </a>
            )
          }
        </div>

        <h1 class="post-title">{title}</h1>

        <div class="locator">
          <div class="locator-plot">
            <Field
              posts={all}
              threads={threads}
              width={300}
              height={220}
              focus={post.id}
              highlight={entry?.thread.id}
              axisLabels="short"
            />
          </div>
          <div class="locator-text">
            <p class="label">Where this sits</p>
            <p class="locator-note">{describePosition(x, y)}</p>
          </div>
        </div>

        <div class="prose">
          <slot />
        </div>

        <nav class="post-nav" aria-label="Thread navigation">
          <div class="post-nav-cell">
            <p class="label">Before this</p>
            {
              previous ? (
                <a href={postUrl(previous)} class="post-nav-link">
                  {previous.data.title}
                </a>
              ) : (
                <p class="post-nav-none">
                  {entry ? 'First in the thread' : 'Belongs to no thread'}
                </p>
              )
            }
          </div>
          <div class="post-nav-cell">
            <p class="label">Next in thread</p>
            {
              next ? (
                <a href={postUrl(next)} class="post-nav-link">
                  {next.data.title}
                </a>
              ) : (
                <p class="post-nav-none">Not written yet</p>
              )
            }
          </div>
        </nav>
      </article>

      <aside class="post-side">
        {
          nearby.length > 0 && (
            <div class="side-block">
              <p class="label">Nearby in the field</p>
              {nearby.map((p) => (
                <a href={postUrl(p)} class="side-link">
                  {p.data.title}
                </a>
              ))}
            </div>
          )
        }

        <a href="/" class="side-back">← The field</a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .post-page {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(14rem, 1fr);
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 1000px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  /* ── Head ── */
  .post-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.625rem;
  }

  .thread-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .thread-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 4.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  /* ── Locator ── */
  .locator {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .locator-plot {
    flex-shrink: 0;
    margin-left: -0.5rem;
  }

  .locator-text {
    flex: 1;
    min-width: 13rem;
  }

  .locator-text .label {
    margin-bottom: 0.4rem;
  }

  .locator-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 38ch;
  }

  /* ── Prose ── */
  .prose {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: var(--prose-width);
  }

  .prose :global(p) {
    margin: 0 0 1.25rem;
  }

  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin: 2.5rem 0 0.875rem;
  }

  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 2rem 0 0.625rem;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    text-underline-offset: 3px;
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .prose :global(a:hover) {
    color: var(--color-accent-hover);
    text-decoration-color: var(--color-accent-hover);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent-a);
    padding: 0.125rem 0 0.125rem 1.5rem;
    margin: 1.75rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125em;
    background: var(--color-bg-sunken);
    padding: 0.12em 0.35em;
    border-radius: 3px;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    padding: 0;
  }

  .prose :global(li) {
    margin-bottom: 0.3rem;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border: 1px solid var(--color-border);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 1.75rem 0;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .prose :global(td) {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Foot ── */
  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .post-nav-cell .label {
    margin-bottom: 0.3rem;
  }

  .post-nav-link {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.4;
  }

  .post-nav-link:hover {
    color: var(--accent-b);
  }

  .post-nav-none {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-text-faint);
    margin: 0;
  }

  /* ── Side ── */
  .post-side .label {
    margin-bottom: 0.875rem;
  }

  .side-block {
    padding-top: 0.5rem;
  }

  .side-link {
    display: block;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.3rem 0;
  }

  .side-link:hover {
    color: var(--accent-b);
  }

  .side-back {
    display: inline-block;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .side-back:hover {
    color: var(--color-text);
  }

  @media (max-width: 560px) {
    .locator {
      gap: 1rem;
    }
    .post-nav {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
