---
// src/components/layout/Footer.astro
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-line">Nothing is allowed to hold until it has been checked at both scales.</p>
    <div class="footer-links">
      <a href="/by-date/" class="footer-link">By date</a>
      <a href="/rss.xml" class="footer-link">RSS</a>
      <a href="https://github.com/morayo0x" target="_blank" rel="noopener" class="footer-link"
        >GitHub</a
      >
      <span class="footer-year">© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-subtle);
    margin: 0;
    max-width: 46ch;
  }

  .footer-links {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .footer-link,
  .footer-year {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .footer-year {
    color: var(--color-text-faint);
  }
</style>
