---
// src/components/layout/SampleNotice.astro
// Shown while any published piece carries `sample: true`. Delete the sample
// files and this disappears with them — there is no switch to remember.
import { hasSamples } from '@utils/field';

const showing = await hasSamples();
---

{
  showing && (
    <div class="sample-notice" role="note">
      <div class="container sample-inner">
        <span class="sample-mark" aria-hidden="true" />
        <p class="sample-text">
          <strong>Specimen text.</strong> These pieces are placeholders, written to show the layout
          with something in it. They are not published writing.
        </p>
      </div>
    </div>
  )
}

<style>
  .sample-notice {
    background: var(--color-bg-sunken);
    border-bottom: 1px solid var(--color-border);
  }

  .sample-inner {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .sample-mark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-b);
    flex-shrink: 0;
    transform: translateY(-1px);
  }

  .sample-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .sample-text strong {
    font-weight: 500;
    color: var(--color-text);
  }
</style>
