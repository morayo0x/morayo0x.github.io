---
// src/components/field/Field.astro
// The plot. One component at three sizes: the home page, a thread page's
// diagram, and the locator in a post's margin.
import { project, threadPath, postUrl, type Letter, type ThreadWithPosts } from '@utils/field';

interface Props {
  posts: Letter[];
  threads: ThreadWithPosts[];
  width?: number;
  height?: number;
  /** Show the title beside each point. Only legible at the largest size. */
  labels?: boolean;
  /** Draw this thread at full strength and dim everything else. */
  highlight?: string;
  /** Ring this piece — used on a post's locator. */
  focus?: string;
  axisLabels?: 'full' | 'short' | 'none';
  /** Points link to their piece. Off for the small diagrams. */
  linked?: boolean;
}

const {
  posts,
  threads,
  width = 860,
  height = 500,
  labels = false,
  highlight,
  focus,
  axisLabels = 'full',
  linked = false,
} = Astro.props;

// Margins leave room for the axis names on all four sides.
const m = axisLabels === 'none' ? 12 : axisLabels === 'short' ? 24 : 60;
const box = {
  left: m,
  top: m - 20 > 0 ? m - 20 : 16,
  width: width - m * 2,
  height: height - (m - 20 > 0 ? m - 20 : 16) - (axisLabels === 'none' ? 12 : 50),
};

const midX = box.left + box.width / 2;
const midY = box.top + box.height / 2;

const dimmed = Boolean(highlight);
const pointR = width > 600 ? 4.5 : width > 400 ? 3.5 : 2.6;

const axisText =
  axisLabels === 'short'
    ? { top: 'RAW', bottom: 'GROUNDED', left: 'HUMAN', right: 'COSMIC' }
    : { top: 'RAW INTUITION', bottom: 'GROUNDED', left: 'HUMAN SCALE', right: 'COSMIC SCALE' };

const axisSize = width > 600 ? 11 : 8;

// Which thread each piece belongs to, and whether that thread is the crossing one.
const threadOf = new Map<string, ThreadWithPosts>();
for (const t of threads) {
  for (const p of t.posts) threadOf.set(p.id, t);
}

const plotted = posts.map((post) => {
  const { cx, cy } = project(post.data.x, post.data.y, box);
  const t = threadOf.get(post.id);
  const isHighlit = !dimmed || (t && t.thread.id === highlight);
  return {
    post,
    cx,
    cy,
    thread: t,
    crossing: t?.thread.data.crossing ?? false,
    active: Boolean(isHighlit),
    isFocus: post.id === focus,
    anchorEnd: cx > midX,
  };
});

const arcs = threads.map((t) => {
  const pts = t.posts.map((p) => project(p.data.x, p.data.y, box));
  return {
    id: t.thread.id,
    d: threadPath(pts),
    crossing: t.thread.data.crossing,
    active: !dimmed || t.thread.id === highlight,
  };
});
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  class="field"
  role="img"
  aria-label={`A plot of ${posts.length} pieces. The horizontal axis runs from human scale to cosmic scale; the vertical axis from raw intuition down to grounded. Threads are drawn as arcs through the pieces that share a question.`}
>
  <rect
    x={box.left}
    y={box.top}
    width={box.width}
    height={box.height}
    fill="none"
    stroke="var(--field-rule)"
    stroke-width="1"></rect>
  <line
    x1={midX}
    y1={box.top}
    x2={midX}
    y2={box.top + box.height}
    stroke="var(--field-rule)"
    stroke-width="1"
    stroke-dasharray="2 5"></line>
  <line
    x1={box.left}
    y1={midY}
    x2={box.left + box.width}
    y2={midY}
    stroke="var(--field-rule)"
    stroke-width="1"
    stroke-dasharray="2 5"></line>

  {
    axisLabels !== 'none' && (
      <>
        <text
          x={midX}
          y={box.top - 10}
          text-anchor="middle"
          fill="var(--field-axis)"
          class="field-axis"
          font-size={axisSize}
        >
          {axisText.top}
        </text>
        <text
          x={midX}
          y={box.top + box.height + 22}
          text-anchor="middle"
          fill="var(--field-axis)"
          class="field-axis"
          font-size={axisSize}
        >
          {axisText.bottom}
        </text>
        <text
          x={box.left - 22}
          y={midY}
          text-anchor="middle"
          fill="var(--field-axis)"
          class="field-axis"
          font-size={axisSize}
          transform={`rotate(-90 ${box.left - 22} ${midY})`}
        >
          {axisText.left}
        </text>
        <text
          x={box.left + box.width + 22}
          y={midY}
          text-anchor="middle"
          fill="var(--field-axis)"
          class="field-axis"
          font-size={axisSize}
          transform={`rotate(90 ${box.left + box.width + 22} ${midY})`}
        >
          {axisText.right}
        </text>
      </>
    )
  }

  {
    arcs.map(
      (arc) =>
        arc.d && (
          <path
            d={arc.d}
            fill="none"
            stroke={arc.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}
            stroke-width={arc.crossing ? 2 : 1.4}
            opacity={arc.active ? (arc.crossing ? 0.75 : 0.45) : 0.12}
          />
        )
    )
  }

  {
    plotted.map((p) => {
      const colour = !p.active
        ? 'var(--field-dim)'
        : p.crossing
          ? 'var(--accent-b)'
          : p.thread
            ? 'var(--accent-a)'
            : 'none';
      const dot = (
        <>
          {p.isFocus && (
            <circle
              cx={p.cx}
              cy={p.cy}
              r={pointR * 2}
              fill="none"
              stroke={p.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}
              stroke-width="1.2"
              opacity="0.5"
            />
          )}
          <circle
            cx={p.cx}
            cy={p.cy}
            r={p.isFocus ? pointR * 1.1 : pointR}
            fill={colour === 'none' ? 'none' : colour}
            stroke={colour === 'none' ? 'var(--field-axis)' : 'none'}
            stroke-width="1.4"
          />
          {labels && (
            <text
              x={p.anchorEnd ? p.cx - 10 : p.cx + 10}
              y={p.cy + 4}
              text-anchor={p.anchorEnd ? 'end' : 'start'}
              fill={p.active ? 'var(--color-text-muted)' : 'var(--field-dim)'}
              class="field-label"
            >
              {p.post.data.title}
            </text>
          )}
        </>
      );

      return linked ? (
        <a href={postUrl(p.post)} class="field-point">
          {dot}
        </a>
      ) : (
        dot
      );
    })
  }
</svg>

<style>
  .field {
    max-width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .field :global(.field-axis) {
    font-family: var(--font-mono);
    letter-spacing: 0.16em;
  }

  .field :global(.field-label) {
    font-family: var(--font-serif);
    font-size: 12.5px;
  }

  .field :global(.field-point) {
    cursor: pointer;
  }

  .field :global(.field-point:hover circle) {
    stroke: var(--color-text);
    stroke-width: 1.2;
  }

  .field :global(.field-point:hover .field-label) {
    fill: var(--color-text);
  }

  .field :global(.field-point:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
