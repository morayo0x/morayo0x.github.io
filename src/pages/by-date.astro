---
// src/pages/by-date.astro
// The plain list. The field is an enhancement; this always works.
import BaseLayout from '@layouts/BaseLayout.astro';
import { getByDate, stamp, postUrl } from '@utils/field';

const posts = await getByDate();

const years = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getUTCFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(post);
}
---

<BaseLayout title="By date" description="Everything, in the order it was written.">
  <div class="container-reading page">
    <header class="page-head">
      <h1 class="page-title">By date</h1>
      <p class="page-line">Everything, in the order it was written.</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">Nothing published yet.</p>
      ) : (
        [...years.entries()].map(([year, group]) => (
          <section class="year">
            <p class="label year-label">{year}</p>
            {group.map((post) => (
              <a href={postUrl(post)} class="row">
                <span class="stamp row-date">{stamp(post.data.pubDate)}</span>
                <span class="row-body">
                  <span class="row-title">{post.data.title}</span>
                  <span class="row-desc">{post.data.description}</span>
                </span>
              </a>
            ))}
          </section>
        ))
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.125rem);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.375rem;
    letter-spacing: -0.01em;
  }

  .page-line {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  .year {
    margin-bottom: 2.25rem;
  }

  .year-label {
    margin-bottom: 0.75rem;
  }

  .row {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    text-decoration: none;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .row-date {
    flex-shrink: 0;
    width: 5.5rem;
  }

  .row-body {
    display: block;
    min-width: 0;
  }

  .row-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .row:hover .row-title {
    color: var(--accent-b);
  }

  .row-desc {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: 0.125rem;
  }

  .empty {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .row {
      flex-direction: column;
      gap: 0.25rem;
    }
    .row-date {
      width: auto;
    }
  }
</style>
