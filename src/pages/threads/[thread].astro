---
// src/pages/threads/[thread].astro
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Field from '@components/field/Field.astro';
import { getThreads, getAllWriting, stamp, postUrl } from '@utils/field';

export async function getStaticPaths() {
  const threads = await getThreads();
  return threads.map((entry) => ({
    params: { thread: entry.thread.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { thread, posts } = entry;
const { Content } = await render(thread);

const all = await getAllWriting();
const threads = await getThreads();
const others = threads.filter((t) => t.thread.id !== thread.id);
const accent = thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)';
---

<BaseLayout title={thread.data.title} description={thread.data.question}>
  <div class="container thread-page">
    <div class="thread-layout">
      <div class="thread-main">
        <p class="label thread-eyebrow" style={`color: ${accent}`}>
          Thread · {posts.length}
          {posts.length === 1 ? 'piece' : 'pieces'}{thread.data.open ? ' · open' : ''}
        </p>
        <h1 class="thread-title">{thread.data.title}</h1>

        <div class="thread-intro">
          <Content />
        </div>

        <ol class="spine" role="list">
          {
            posts.map((post, i) => (
              <li class="spine-item">
                <span class="spine-rail" aria-hidden="true">
                  <span class="spine-dot" style={`background: ${accent}`} />
                  {i < posts.length - 1 && (
                    <span class="spine-line" style={`background: ${accent}`} />
                  )}
                </span>
                <span class="spine-body">
                  <span class="stamp">{stamp(post.data.pubDate)}</span>
                  <a href={postUrl(post)} class="spine-title">
                    {post.data.title}
                  </a>
                  <span class="spine-desc">{post.data.description}</span>
                </span>
              </li>
            ))
          }
        </ol>

        {
          thread.data.open && (
            <div class="open">
              <p class="label">Not yet written</p>
              <p class="open-text">{thread.data.open}</p>
            </div>
          )
        }
      </div>

      <aside class="thread-side">
        <p class="label">Where it runs</p>
        <Field
          posts={all}
          threads={threads}
          width={420}
          height={300}
          highlight={thread.id}
          axisLabels="short"
        />

        {
          others.length > 0 && (
            <div class="other-threads">
              <p class="label">Other threads</p>
              {others.map((t) => (
                <a href={`/threads/${t.thread.id}/`} class="other-row">
                  <span
                    class="other-dot"
                    style={`background: ${t.thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}`}
                  />
                  <span class="other-name">{t.thread.data.title}</span>
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .thread-page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .thread-layout {
    display: grid;
    grid-template-columns: minmax(0, 40rem) minmax(15rem, 1fr);
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 1000px) {
    .thread-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .thread-eyebrow {
    margin-bottom: 0.5rem;
  }

  .thread-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.875rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .thread-intro :global(p) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 1.25rem;
    max-width: 58ch;
  }

  /* ── Spine ── */
  .spine {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .spine-item {
    display: flex;
    gap: 1.5rem;
  }

  .spine-rail {
    width: 11px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .spine-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  .spine-line {
    width: 1.5px;
    flex-grow: 1;
    opacity: 0.35;
  }

  .spine-body {
    display: block;
    padding-bottom: 1.75rem;
    min-width: 0;
  }

  .spine-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.3;
    margin: 0.125rem 0 0.3rem;
  }

  .spine-title:hover {
    color: var(--accent-b);
  }

  .spine-desc {
    display: block;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .open {
    margin-top: 1rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--color-border);
  }

  .open .label {
    margin-bottom: 0.3rem;
  }

  .open-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 56ch;
  }

  /* ── Side ── */
  .thread-side .label {
    margin-bottom: 0.875rem;
  }

  .other-threads {
    margin-top: 1.75rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--color-border);
  }

  .other-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    padding: 0.3rem 0;
  }

  .other-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .other-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
  }

  .other-row:hover .other-name {
    color: var(--accent-b);
  }
</style>
