---
// src/pages/index.astro — the field
import BaseLayout from '@layouts/BaseLayout.astro';
import Field from '@components/field/Field.astro';
import { getAllWriting, getByDate, getThreads, getLoose, stampMonth, postUrl } from '@utils/field';

const posts = await getAllWriting();
const recent = (await getByDate()).slice(0, 3);
const threads = await getThreads();
const loose = await getLoose();

const span =
  posts.length > 0
    ? `${posts[0].data.pubDate.getUTCFullYear()}–${posts[posts.length - 1].data.pubDate.getUTCFullYear()}`
    : null;
---

<BaseLayout
  title="Home"
  description="Writing placed on a field: where each piece sits between formal systems and the institutions people run, and how far it has been checked."
>
  <div class="container field-page">
    <header class="intro">
      <h1 class="intro-title">A field of unfinished proofs</h1>
      <p class="intro-line">
        Not a list by date. Where a piece sits between the human scale and the cosmic one, and how
        far it has been carried from a hunch toward something checked.
        {
          span && (
            <span class="intro-span">
              {posts.length} pieces, {span}.
            </span>
          )
        }
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="field-layout">
          <div class="field-plot">
            <Field posts={posts} threads={threads} labels={true} linked={true} />
          </div>

          <aside class="field-side">
            {threads.length > 0 && (
              <div class="side-block">
                <p class="label">Threads</p>
                {threads.map(({ thread, posts: tp }) => (
                  <a href={`/threads/${thread.id}/`} class="thread-row">
                    <span class="thread-head">
                      <span
                        class="thread-dot"
                        style={`background: ${thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}`}
                      />
                      <span class="thread-name">{thread.data.title}</span>
                      <span class="thread-count">{tp.length}</span>
                    </span>
                    <span class="thread-question">{thread.data.question}</span>
                  </a>
                ))}
                {loose.length > 0 && (
                  <p class="thread-loose">
                    <span class="thread-dot thread-dot--hollow" />
                    {loose.length} loose, belonging to nothing
                  </p>
                )}
              </div>
            )}

            <div class="side-block side-recent">
              <p class="label">Most recent</p>
              {recent.map((post) => (
                <a href={postUrl(post)} class="recent-row">
                  <span class="stamp">{stampMonth(post.data.pubDate)}</span>
                  <span class="recent-title">{post.data.title}</span>
                </a>
              ))}
              <a href="/by-date/" class="side-more">
                All, by date →
              </a>
            </div>
          </aside>
        </div>
      ) : (
        <div class="empty">
          <h2 class="empty-title">The field is empty</h2>
          <p class="empty-body">
            Nothing has been placed yet. Each piece takes a position — how far it sits from the
            human scale toward the cosmic one, and how far from a hunch toward something checked —
            and threads are drawn through the pieces that share a question.
          </p>
          <p class="empty-body">
            The plot appears once there is something to plot. Until then, the feed is the way to
            know when there is.
          </p>
          <a href="/rss.xml" class="empty-link">
            RSS
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .field-page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .intro {
    margin-bottom: 2rem;
    max-width: 62ch;
  }

  .intro-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .intro-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  .intro-span {
    font-style: normal;
    color: var(--color-text-faint);
  }

  /* ── Layout ── */
  .field-layout {
    display: grid;
    grid-template-columns: minmax(0, 860px) minmax(15rem, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 1100px) {
    .field-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .field-plot {
    min-width: 0;
    overflow-x: auto;
  }

  /* ── Side column ── */
  .field-side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .side-block .label {
    margin-bottom: 0.875rem;
  }

  .thread-row {
    display: block;
    text-decoration: none;
    padding-bottom: 0.875rem;
    margin-bottom: 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }

  .thread-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .thread-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .thread-dot--hollow {
    background: transparent;
    border: 1.5px solid var(--color-text-faint);
    display: inline-block;
    margin-right: 0.4rem;
  }

  .thread-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    flex: 1;
  }

  .thread-row:hover .thread-name {
    color: var(--accent-b);
  }

  .thread-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-faint);
  }

  .thread-question {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .thread-loose {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    align-items: center;
  }

  .side-recent {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .recent-row {
    display: flex;
    gap: 0.875rem;
    align-items: baseline;
    text-decoration: none;
    padding: 0.25rem 0;
  }

  .recent-title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .recent-row:hover .recent-title {
    color: var(--accent-b);
  }

  .side-more {
    display: inline-block;
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ── Empty ── */
  .empty {
    max-width: 58ch;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .empty-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .empty-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
    padding: 0.4rem 0.875rem;
    margin-top: 0.5rem;
  }

  .empty-link:hover {
    border-color: var(--color-accent);
  }
</style>
