---
// src/pages/index.astro — the field
import BaseLayout from '@layouts/BaseLayout.astro';
import Field from '@components/field/Field.astro';
import { getAllWriting, getByDate, getThreads, getLoose, stamp, postUrl } from '@utils/field';

const posts = await getAllWriting();
const threads = await getThreads();
const loose = await getLoose();

const byDate = await getByDate();
const [lead, ...rest] = byDate.slice(0, 3);

// Which thread a piece belongs to, for the lead card's badge.
const threadOf = new Map<string, (typeof threads)[number]>();
for (const t of threads) {
  for (const p of t.posts) threadOf.set(p.id, t);
}
const leadThread = lead ? threadOf.get(lead.id) : undefined;

const span =
  posts.length > 0
    ? `${posts[0].data.pubDate.getUTCFullYear()}–${posts[posts.length - 1].data.pubDate.getUTCFullYear()}`
    : null;
---

<BaseLayout
  title="Home"
  description="Morayo — computer science at the University of Lagos, by way of physics. Writing on machine learning, how it gets taught, and what happens when either meets an institution."
>
  <div class="container home">
    <header class="intro">
      <h1 class="intro-lead">
        I study computer science at the University of Lagos, by way of physics.
      </h1>
      <p class="intro-body">
        Most of my work is about how machine learning gets taught — curriculum for the lecturers who
        will teach it, training for the people who will build with it. The rest is my own study,
        done slowly and from first principles, because I have not found a faster way that sticks.
      </p>
      <p class="intro-body">
        I write here about what I cannot put down: what a model is actually doing under the
        notation, what an argument owes you before you are allowed to believe it, and what becomes
        of either once it meets an institution.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <>
          <section class="plot-section" aria-labelledby="field-heading">
            <div class="plot-head">
              <h2 id="field-heading" class="label">
                The field
              </h2>
              <p class="plot-caption">
                Placed, not listed. Across, the human scale to the cosmic; down, a hunch to
                something checked.
                <span class="plot-count">
                  {posts.length} pieces, {span}.
                </span>
              </p>
            </div>
            <div class="plot-frame">
              <Field posts={posts} threads={threads} labels={true} linked={true} />
            </div>
          </section>

          <section class="recent" aria-labelledby="recent-heading">
            <h2 id="recent-heading" class="label">
              Most recent
            </h2>

            <a href={postUrl(lead)} class="lead-card">
              <span class="lead-meta">
                <span class="stamp">{stamp(lead.data.pubDate)}</span>
                {leadThread && (
                  <span
                    class="lead-thread"
                    style={`color: ${leadThread.thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}`}
                  >
                    <span
                      class="lead-dot"
                      style={`background: ${leadThread.thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}`}
                    />
                    {leadThread.thread.data.title}
                  </span>
                )}
              </span>
              <span class="lead-title">{lead.data.title}</span>
              <span class="lead-desc">{lead.data.description}</span>
            </a>

            {rest.length > 0 && (
              <div class="rest">
                {rest.map((post) => (
                  <a href={postUrl(post)} class="rest-row">
                    <span class="stamp rest-date">{stamp(post.data.pubDate)}</span>
                    <span class="rest-title">{post.data.title}</span>
                  </a>
                ))}
              </div>
            )}

            <a href="/by-date/" class="more">
              All, by date →
            </a>
          </section>

          {threads.length > 0 && (
            <section class="threads" aria-labelledby="threads-heading">
              <h2 id="threads-heading" class="label">
                Threads
              </h2>
              {threads.map(({ thread, posts: tp }) => (
                <a href={`/threads/${thread.id}/`} class="thread-row">
                  <span class="thread-head">
                    <span
                      class="thread-dot"
                      style={`background: ${thread.data.crossing ? 'var(--accent-b)' : 'var(--accent-a)'}`}
                    />
                    <span class="thread-name">{thread.data.title}</span>
                    <span class="thread-count">
                      {tp.length} {tp.length === 1 ? 'piece' : 'pieces'}
                    </span>
                  </span>
                  <span class="thread-question">{thread.data.question}</span>
                </a>
              ))}
              {loose.length > 0 && (
                <p class="thread-loose">
                  <span class="thread-dot thread-dot--hollow" />
                  {loose.length} loose, belonging to nothing
                </p>
              )}
            </section>
          )}
        </>
      ) : (
        <div class="empty">
          <h2 class="empty-title">Nothing placed yet</h2>
          <p class="empty-body">
            Each piece takes a position — how far it sits from the human scale toward the cosmic
            one, and how far from a hunch toward something checked — and threads are drawn through
            the pieces that share a question.
          </p>
          <p class="empty-body">
            The plot appears once there is something to plot. Until then, the feed is the way to
            know when there is.
          </p>
          <a href="/rss.xml" class="empty-link">
            RSS
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 58rem;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  /* ── Intro ── */
  .intro {
    max-width: 60ch;
    margin-bottom: 3.5rem;
  }

  .intro-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.2vw, 1.9rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .intro-body {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .intro-body:last-child {
    margin-bottom: 0;
  }

  /* ── Plot ── */
  .plot-section {
    margin-bottom: 3.5rem;
  }

  .plot-head {
    margin-bottom: 1.25rem;
  }

  .plot-head .label {
    margin-bottom: 0.4rem;
  }

  .plot-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 64ch;
  }

  .plot-count {
    font-style: normal;
    color: var(--color-text-faint);
  }

  .plot-frame {
    overflow-x: auto;
  }

  /* ── Most recent ── */
  .recent {
    margin-bottom: 3.5rem;
  }

  .recent .label {
    margin-bottom: 0.875rem;
  }

  .lead-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-elevated);
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    box-shadow: var(--lift-rest);
    transform: translateY(0);
    transition:
      border-color var(--transition-fast),
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .lead-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--lift-hover);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-card {
      transition: border-color var(--transition-fast);
    }
    .lead-card:hover {
      transform: none;
    }
  }

  .lead-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .lead-thread {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lead-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .lead-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .lead-card:hover .lead-title {
    color: var(--accent-b);
  }

  .lead-desc {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  .rest {
    margin-top: 0.25rem;
  }

  .rest-row {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rest-date {
    flex-shrink: 0;
    width: 5.5rem;
  }

  .rest-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .rest-row:hover .rest-title {
    color: var(--accent-b);
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .more:hover {
    color: var(--color-accent-hover);
  }

  /* ── Threads ── */
  .threads .label {
    margin-bottom: 0.875rem;
  }

  .thread-row {
    display: block;
    text-decoration: none;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .thread-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .thread-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .thread-dot--hollow {
    background: transparent;
    border: 1.5px solid var(--color-text-faint);
    display: inline-block;
    margin-right: 0.45rem;
  }

  .thread-name {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-text);
    flex: 1;
  }

  .thread-row:hover .thread-name {
    color: var(--accent-b);
  }

  .thread-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .thread-question {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 68ch;
  }

  .thread-loose {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0.875rem 0 0;
    display: flex;
    align-items: center;
  }

  /* ── Empty ── */
  .empty {
    max-width: 58ch;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .empty-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .empty-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
    padding: 0.4rem 0.875rem;
    margin-top: 0.5rem;
  }

  .empty-link:hover {
    border-color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .lead-card {
      padding: 1.25rem 1.25rem;
    }
    .rest-row {
      flex-direction: column;
      gap: 0.2rem;
    }
    .rest-date {
      width: auto;
    }
  }
</style>
