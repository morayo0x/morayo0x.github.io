---
// src/pages/search.astro
// Queries the Pagefind index that the deploy workflow generates.
// The index lives at /pagefind/ and only exists after a production build,
// so this page degrades to a clear message in `astro dev`.
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every post on the site.">
  <div class="page-wrap">
    <header class="page-header">
      <h1 class="page-title">Search</h1>
      <p class="page-desc">Full text across every post.</p>
    </header>

    <form id="search-form" class="search-form" role="search" action="/search/" method="get">
      <label for="search-input" class="sr-only">Search posts</label>
      <div class="search-field">
        <svg
          class="search-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="search-input"
          name="q"
          type="search"
          class="search-input"
          placeholder="Search the writing…"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
        />
        <kbd class="search-shortcut" aria-hidden="true">/</kbd>
      </div>
    </form>

    <p id="search-status" class="search-status" role="status" aria-live="polite"></p>

    <div id="search-results" class="search-results"></div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    width: 100%;
    max-width: 52rem;
    margin-left: auto;
    margin-right: auto;
    padding: 0 1.5rem 5rem;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .page-wrap {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .page-header {
    padding: 3rem 0 1.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin: 0 0 0.375rem;
  }

  .page-desc {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    font-size: 1rem;
    margin: 0;
  }

  /* ── Field ── */
  .search-form {
    margin-bottom: 1.25rem;
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    color: var(--color-text-subtle);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    padding: 0.75rem 2.75rem 0.75rem 2.5rem;
    outline: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    -webkit-appearance: none;
  }

  .search-input::placeholder {
    color: var(--color-text-subtle);
  }

  .search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-shortcut {
    position: absolute;
    right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
    pointer-events: none;
    line-height: 1.4;
  }

  .search-input:focus + .search-shortcut {
    display: none;
  }

  /* ── Status ── */
  .search-status {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    min-height: 1.25rem;
  }

  /* ── Results ── */
  .search-results :global(.result) {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .search-results :global(.result:hover .result-title) {
    color: var(--color-accent);
  }

  .search-results :global(.result-title) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0 0 0.375rem;
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);
  }

  .search-results :global(.result-excerpt) {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .search-results :global(.result-excerpt mark) {
    background: var(--color-accent-light);
    color: var(--color-accent-hover);
    font-weight: 600;
    padding: 0 0.15em;
    border-radius: 2px;
  }

  .search-results :global(.result-meta) {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
  }
</style>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta?: Record<string, string | undefined>;
  }

  interface PagefindModule {
    init(): Promise<void>;
    search(query: string): Promise<{ results: { data(): Promise<PagefindResultData> }[] }>;
  }

  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');

  const MAX_RESULTS = 20;

  let pagefind: PagefindModule | null = null;
  let unavailable = false;
  let token = 0;

  async function getPagefind(): Promise<PagefindModule | null> {
    if (pagefind || unavailable) return pagefind;
    try {
      // Held in a variable so the bundler leaves this alone — the index is
      // generated after the build, not resolvable at build time.
      const modulePath = '/pagefind/pagefind.js';
      const loaded = (await import(/* @vite-ignore */ modulePath)) as unknown as PagefindModule;
      await loaded.init();
      pagefind = loaded;
    } catch {
      unavailable = true;
    }
    return pagefind;
  }

  function setStatus(text: string) {
    if (status) status.textContent = text;
  }

  function render(items: PagefindResultData[]) {
    if (!results) return;
    results.textContent = '';

    for (const item of items) {
      const link = document.createElement('a');
      link.className = 'result';
      link.href = item.url;

      const title = document.createElement('h2');
      title.className = 'result-title';
      title.textContent = item.meta?.title ?? item.url;
      link.appendChild(title);

      const excerpt = document.createElement('p');
      excerpt.className = 'result-excerpt';
      // Pagefind returns its own first-party excerpt with <mark> around hits.
      excerpt.innerHTML = item.excerpt;
      link.appendChild(excerpt);

      const bits = [item.meta?.category, item.meta?.date].filter(Boolean);
      if (bits.length) {
        const meta = document.createElement('p');
        meta.className = 'result-meta';
        meta.textContent = bits.join(' · ');
        link.appendChild(meta);
      }

      results.appendChild(link);
    }
  }

  async function run(query: string) {
    const current = ++token;
    const trimmed = query.trim();

    if (!trimmed) {
      render([]);
      setStatus('');
      return;
    }

    const engine = await getPagefind();
    if (current !== token) return;

    if (!engine) {
      render([]);
      setStatus(
        'The search index is missing. It is generated at build time — run `npm run build`, then `npx pagefind --site dist`.'
      );
      return;
    }

    setStatus('Searching…');
    const search = await engine.search(trimmed);
    if (current !== token) return;

    const items = await Promise.all(search.results.slice(0, MAX_RESULTS).map((r) => r.data()));
    if (current !== token) return;

    render(items);
    if (items.length === 0) {
      setStatus(`No results for “${trimmed}”.`);
    } else {
      setStatus(`${items.length} result${items.length === 1 ? '' : 's'} for “${trimmed}”.`);
    }
  }

  let timer: number | undefined;
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => run(input.value), 160);
  });

  // Keep the URL shareable, and don't reload the page on Enter.
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input?.value ?? '';
    const url = new URL(window.location.href);
    if (value.trim()) {
      url.searchParams.set('q', value);
    } else {
      url.searchParams.delete('q');
    }
    window.history.replaceState({}, '', url);
    run(value);
  });

  // '/' focuses the field, Escape clears it.
  document.addEventListener('keydown', (event) => {
    const tag = document.activeElement?.tagName;
    if (event.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
      event.preventDefault();
      input?.focus();
      input?.select();
    }
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      input.value = '';
      run('');
      input.blur();
    }
  });

  // Honour /search/?q=… — the shape advertised in the site's JSON-LD.
  const initial = new URLSearchParams(window.location.search).get('q');
  if (initial && input) {
    input.value = initial;
    run(initial);
  }
  input?.focus();
</script>
